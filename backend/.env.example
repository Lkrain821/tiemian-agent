# The application also accepts the legacy aliases BASE_URL and MODEL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_THINKING_MODE=disabled

# Default baseline. Shadow always keeps DeepSeek in control, even with provider=jev.
DECISION_PROVIDER=deepseek
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=3
JEV_FOLLOWUP_THRESHOLD=0.70
JEV_SCORE_THRESHOLD=0.30
JEV_MIN_CONFIDENCE=0.60
JEV_FALLBACK_ENABLED=true
JEV_SHADOW_MODE=false

APP_DB_PATH=../data/tiemian.sqlite3
CHECKPOINT_DB_PATH=../data/checkpoints.sqlite3
QUESTION_BANK_PATH=../data/questions.json
LOG_LEVEL=INFO
APP_ENV=development
